# Copy to .env and fill in. Comments must be on their own line: python-dotenv reads
# `KEY=   # note` as the literal value "# note" (the gateway also ignores values
# starting with "#" as a safety net, but don't rely on it).

# ---- OpenRouter -----------------------------------------------------------
# required
OPENROUTER_API_KEY=
# optional attribution headers (HTTP-Referer / X-Title)
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=multi-llm-router-gateway

# ---- Gateway access ------------------------------------------------------
# comma-separated client keys for this gateway (empty = every request is rejected)
GATEWAY_API_KEYS=
RATE_LIMIT_RPM_PER_KEY=60
MAX_BODY_BYTES=1000000

# ---- Free tier (openai/gpt-oss-20b:free) ---------------------------------
# raise to 1000 once $10+ credits are on the OpenRouter account
FREE_TIER_DAILY_CAP=50
FREE_TIER_RPM_CAP=20
# The gateway system prompt is NOT sent on the SIMPLE (free) tier by default, because
# free providers may log or train on inputs. Set true only if it contains nothing sensitive.
FREE_TIER_SEND_GATEWAY_SYSTEM_PROMPT=false

# ---- Break-glass direct providers (disabled by default) ------------------
# Used only after the whole OpenRouter chain fails; needs key + model ID per provider.
BREAK_GLASS_ENABLED=false
# optional: break-glass direct path (disabled by default)
ANTHROPIC_API_KEY=
BREAK_GLASS_ANTHROPIC_MODEL=
# optional: break-glass direct path (disabled by default)
GEMINI_API_KEY=
BREAK_GLASS_GEMINI_MODEL=

# ---- Observability (Langfuse Python SDK v4) ------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SDK v4 reads LANGFUSE_BASE_URL (e.g. https://cloud.langfuse.com); legacy LANGFUSE_HOST is also accepted
LANGFUSE_BASE_URL=
ENABLE_TRACING=true
# false = traces carry lengths/hashes only, never prompt or completion text
TRACE_RAW_CONTENT=false
# HMAC salt for hashed key/user IDs in traces and feature logs
TRACE_HASH_SALT=

# ---- Features --------------------------------------------------------------
ENABLE_SEMANTIC_CACHE=false
# direct | cascade
ROUTING_MODE=direct
VALIDATE_MODELS_ON_STARTUP=true
LOG_LEVEL=INFO
